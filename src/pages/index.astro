---
import Base from '../layouts/Base.astro';
import ProjectRows from '../components/ProjectRows.astro';
import PostRows from '../components/PostRows.astro';
---
<Base>
  <section class="hero">
    <h1 class="display hero-name">Alex<br />Tramiel</h1>
    <p class="lede">I run operations for hardware companies, and I build robots that fight and play hockey.</p>
    <canvas class="scope" aria-hidden="true"></canvas>
  </section>

  <section class="home-section">
    <h2 class="section-title">Things I've built and run</h2>
    <ProjectRows />
  </section>

  <section class="home-section">
    <h2 class="section-title">Recent writing</h2>
    <PostRows limit={5} />
    <a class="more" href="/writing/">All writing</a>
  </section>
</Base>

<style>
  .hero { padding: clamp(1.5rem, 5vw, 4rem) 0 clamp(2.5rem, 6vw, 4.5rem); }
  .hero-name { font-size: clamp(5rem, 26vw, 17rem); text-transform: uppercase; margin-left: -0.04em; width: fit-content; cursor: pointer; user-select: none; }
  .scope { display: block; width: 100%; height: clamp(5rem, 12vw, 8rem); margin-top: clamp(2rem, 5vw, 3.5rem); border: 1px solid var(--line); border-radius: 4px; background: rgba(5, 9, 8, 0.6); }
  .hero .lede { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  .home-section { margin-top: clamp(3rem, 7vw, 5rem); }
  .home-section .section-title { margin-bottom: 0; }
  .home-section :global(.rows) { margin-top: 0; }
  .home-section > :global(.rows) { margin-top: 1.25rem; border-top: 2px solid var(--gold); }
</style>
