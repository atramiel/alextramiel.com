---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description}>
  <header class="page-head">
    <h1 class="display page-title">{d.title}</h1>
    <p class="post-meta">
      <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
      {d.tags.length > 0 && <span>, filed under {d.tags.join(', ')}</span>}
    </p>
  </header>
  {d.cover && <Image class="cover" src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1152, 1600]} sizes="(max-width: 72rem) 100vw, 72rem" />}
  <article class="prose"><Content /></article>
  <a class="back" href="/writing/">All writing</a>
</Base>
